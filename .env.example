# Copy to .env (`cp .env.example .env`) and fill in your credentials on the execution host.
# Never commit .env to git.

# ------------------------------------------------------------------------------
# 1. Teacher Inference (OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
REPOOPT_TEACHER_MODEL=z-ai/glm-5.3

# ------------------------------------------------------------------------------
# 2. Student SFT & On-Policy RL (Thinking Machines Tinker)
# ------------------------------------------------------------------------------
TINKER_API_KEY=tml-REPLACE_ME
REPOOPT_STUDENT_MODEL=Qwen/Qwen3.5-9B

# ------------------------------------------------------------------------------
# 3. Canonical Trace & Dataset Storage (Local or AWS S3)
# ------------------------------------------------------------------------------
# Use "s3" on cloud/production hosts or "local" during single-machine development.
REPOOPT_STORAGE_BACKEND=s3
REPOOPT_S3_BUCKET=your-repoopt-bucket
REPOOPT_S3_PREFIX=prod
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-west-2
# Optional S3-compatible endpoint (MinIO / R2 / etc.):
# REPOOPT_S3_ENDPOINT_URL=https://s3.example.com
REPOOPT_LOCAL_STORE_ROOT=artifacts_store

# ------------------------------------------------------------------------------
# 4. Trace & Experiment Observability (MLflow on Databricks)
# ------------------------------------------------------------------------------
REPOOPT_MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=databricks
DATABRICKS_HOST=https://dbc-REPLACE_ME.cloud.databricks.com
DATABRICKS_TOKEN=dapi_REPLACE_ME
# Databricks MLflow experiment names must be absolute workspace paths:
MLFLOW_EXPERIMENT_NAME=/Users/your.email@company.com/repoopt
REPOOPT_MLFLOW_LOG_ARTIFACTS=true

# ------------------------------------------------------------------------------
# 5. Distributed Sandbox Execution (Anyscale / Harbor Ray Backend)
# ------------------------------------------------------------------------------
ANYSCALE_HOST=https://console.anyscale.com
ANYSCALE_CLI_TOKEN=REPLACE_ME
REPOOPT_RAY_IMPORT_PATH=harbor_ray.environment:RayEnvironment
