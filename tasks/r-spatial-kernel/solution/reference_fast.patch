--- /dev/null
+++ b/src/matern.c
@@ -0,0 +1,74 @@
+#include <R.h>
+#include <Rinternals.h>
+#include <R_ext/Rdynload.h>
+#include <math.h>
+
+SEXP C_matern32_self(SEXP coords_sexp, SEXP ls_sexp, SEXP nugget_sexp) {
+    SEXP dims = getAttrib(coords_sexp, R_DimSymbol);
+    int n = INTEGER(dims)[0];
+    int d = INTEGER(dims)[1];
+    const double *coords = REAL(coords_sexp);
+    const double *ls = REAL(ls_sexp);
+    double nugget = REAL(nugget_sexp)[0];
+    double sqrt3 = sqrt(3.0);
+
+    SEXP out = PROTECT(allocMatrix(REALSXP, n, n));
+    double *K = REAL(out);
+
+    for (int i = 0; i < n; ++i) {
+        K[i + (size_t)n * i] = 1.0 + nugget;
+        for (int j = i + 1; j < n; ++j) {
+            double dist_sq = 0.0;
+            for (int k = 0; k < d; ++k) {
+                double diff = (coords[i + (size_t)n * k] - coords[j + (size_t)n * k]) / ls[k];
+                dist_sq += diff * diff;
+            }
+            double r = sqrt3 * sqrt(dist_sq);
+            double val = (1.0 + r) * exp(-r);
+            K[i + (size_t)n * j] = val;
+            K[j + (size_t)n * i] = val;
+        }
+    }
+    UNPROTECT(1);
+    return out;
+}
+
+SEXP C_matern32_cross(SEXP tgt_sexp, SEXP coords_sexp, SEXP ls_sexp) {
+    SEXP tgt_dims = getAttrib(tgt_sexp, R_DimSymbol);
+    SEXP crd_dims = getAttrib(coords_sexp, R_DimSymbol);
+    int m = INTEGER(tgt_dims)[0];
+    int d = INTEGER(tgt_dims)[1];
+    int n = INTEGER(crd_dims)[0];
+    const double *tgt = REAL(tgt_sexp);
+    const double *coords = REAL(coords_sexp);
+    const double *ls = REAL(ls_sexp);
+    double sqrt3 = sqrt(3.0);
+
+    SEXP out = PROTECT(allocMatrix(REALSXP, m, n));
+    double *K = REAL(out);
+
+    for (int j = 0; j < n; ++j) {
+        for (int i = 0; i < m; ++i) {
+            double dist_sq = 0.0;
+            for (int k = 0; k < d; ++k) {
+                double diff = (tgt[i + (size_t)m * k] - coords[j + (size_t)n * k]) / ls[k];
+                dist_sq += diff * diff;
+            }
+            double r = sqrt3 * sqrt(dist_sq);
+            K[i + (size_t)m * j] = (1.0 + r) * exp(-r);
+        }
+    }
+    UNPROTECT(1);
+    return out;
+}
+
+static const R_CallMethodDef CallEntries[] = {
+    {"C_matern32_self", (DL_FUNC) &C_matern32_self, 3},
+    {"C_matern32_cross", (DL_FUNC) &C_matern32_cross, 3},
+    {NULL, NULL, 0}
+};
+
+void R_init_spatialkern(DllInfo *dll) {
+    R_registerRoutines(dll, NULL, CallEntries, NULL, NULL);
+    R_useDynamicSymbols(dll, FALSE);
+}
